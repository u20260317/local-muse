{
  "version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "use_reloader": false
  },
  "scheduler": {
    "daily_task_limit": 10,
    "max_concurrency": 2,
    "default_api_max_concurrency": 1,
    "interval_seconds": 300,
    "schedule_times": [
      "09:00",
      "18:00"
    ],
    "retry_times": 2,
    "task_timeout_seconds": 600,
    "manual_enqueue_mode": "queue",
    "subprocess_memory_limit_mb": 512
  },
  "hardware": {
    "cpu_threshold": 85,
    "memory_threshold": 85,
    "sample_interval_seconds": 2,
    "recovery_margin": 10
  },
  "browser": {
    "enabled": true,
    "engine": "browserr",
    "headless": true,
    "timeout_seconds": 60,
    "navigation_timeout_ms": 30000,
    "per_session_profile": true,
    "extra_args": []
  },
  "upload": {
    "enabled": false,
    "repo": "",
    "target": ""
  },
  "compose": {
    "enabled": true,
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "scene_seconds": 4.0,
    "transition_seconds": 0.5,
    "voice_enabled": true,
    "voice": "zh-CN-XiaoxiaoNeural",
    "bgm_path": ""
  },
  "providers": [
    {
      "name": "zen_gate_local",
      "kind": "text",
      "base_url": "http://127.0.0.1:8787/v1",
      "path": "/chat/completions",
      "style": "openai_chat",
      "model": "deepseek-v4.1-flash-free",
      "api_key": "",
      "enabled": true,
      "priority": 100,
      "weight": 3,
      "rpm": 10,
      "max_concurrency": 1,
      "timeout_s": 90,
      "doc": "https://github.com/LAGcomcom/zen-gate",
      "quota_note": "本机 zen-gate 网关：OpenCode Zen 免费车道，额度按出口 IP 计量，限流时 zen-gate 自动 failover；模型名单以 GET /v1/models 实时返回为准（测试时为 5 个 *-free 模型）",
      "risk_note": "仅本机回环调用，不出公网到第三方 API 站点（zen-gate 到上游除外）；api_key 为 zen-gate 本机 mainKey，不要写进仓库：留空时程序自动读环境变量 ZEN_GATE_API_KEY"
    },
    {
      "name": "openrouter_free",
      "kind": "text",
      "base_url": "https://openrouter.ai/api/v1",
      "path": "/chat/completions",
      "style": "openai_chat",
      "model": "google/gemma-4-31b-it:free",
      "api_key": "",
      "enabled": false,
      "priority": 10,
      "weight": 3,
      "rpm": 10,
      "max_concurrency": 1,
      "timeout_s": 60,
      "doc": "https://openrouter.ai/docs/api-reference/chat",
      "quota_note": "OpenRouter 带 :free 后缀的模型走免费层，有每分钟/每日请求上限；免费模型列表会变动",
      "risk_note": "免费模型仍需 API Key；免费层数据可能被用于模型改进，勿传敏感信息；额度与模型下线以官方公告为准"
    },
    {
      "name": "minimax_text",
      "kind": "text",
      "base_url": "https://api.minimax.chat",
      "path": "/v1/text/chatcompletion_v2",
      "style": "minimax_chat",
      "model": "MiniMax-Text-01",
      "api_key": "",
      "enabled": false,
      "weight": 1,
      "rpm": 6,
      "max_concurrency": 1,
      "timeout_s": 60,
      "doc": "https://platform.minimaxi.com/document/ChatCompletion%20v2",
      "quota_note": "新用户赠送额度/活动免费额度，以官方公告为准",
      "risk_note": "额度与模型名可能调整；请确认是否计费后再开启"
    },
    {
      "name": "deepseek_text",
      "kind": "text",
      "base_url": "https://api.deepseek.com",
      "path": "/chat/completions",
      "style": "openai_chat",
      "model": "deepseek-chat",
      "api_key": "",
      "enabled": false,
      "weight": 2,
      "rpm": 10,
      "max_concurrency": 1,
      "timeout_s": 60,
      "doc": "https://api-docs.deepseek.com/",
      "quota_note": "按官方当期赠送余额为准，非永久免费",
      "risk_note": "赠送余额耗尽后会计费；并发过高易 429"
    },
    {
      "name": "gemini_free",
      "kind": "text",
      "base_url": "https://generativelanguage.googleapis.com",
      "path": "/v1beta/models/gemini-2.0-flash:generateContent",
      "style": "gemini",
      "model": "gemini-2.0-flash",
      "api_key": "",
      "enabled": false,
      "weight": 2,
      "rpm": 10,
      "max_concurrency": 1,
      "timeout_s": 60,
      "doc": "https://ai.google.dev/gemini-api/docs",
      "quota_note": "免费层按每分钟请求数/每日请求数限制，随地区与模型变化",
      "risk_note": "国内网络可能不可达；免费层数据可能被用于模型改进，勿传敏感信息"
    },
    {
      "name": "qwen_free",
      "kind": "text",
      "base_url": "https://dashscope.aliyuncs.com",
      "path": "/compatible-mode/v1/chat/completions",
      "style": "openai_chat",
      "model": "qwen-plus",
      "api_key": "",
      "enabled": false,
      "weight": 1,
      "rpm": 6,
      "max_concurrency": 1,
      "timeout_s": 60,
      "doc": "https://help.aliyun.com/zh/model-studio/developer-reference/compatibility-of-openai-with-dashscope",
      "quota_note": "新用户各模型有百万级 Token 免费额度，有效期以官方为准",
      "risk_note": "额度有有效期；确认所用模型是否在免费范围"
    },
    {
      "name": "minimax_image",
      "kind": "image",
      "base_url": "https://api.minimax.chat",
      "path": "/v1/image_generation",
      "style": "generic_image",
      "model": "image-01",
      "api_key": "",
      "enabled": false,
      "weight": 1,
      "rpm": 4,
      "max_concurrency": 1,
      "timeout_s": 120,
      "doc": "https://platform.minimaxi.com/document/Image%20Generation",
      "quota_note": "以官方赠送额度为准",
      "risk_note": "图片接口可能单独计费，开启前确认余额"
    },
    {
      "name": "sd_free",
      "kind": "image",
      "base_url": "https://api-inference.huggingface.co",
      "path": "/models/stabilityai/stable-diffusion-xl-base-1.0",
      "style": "hf_inference",
      "model": "stable-diffusion-xl-base-1.0",
      "api_key": "",
      "enabled": false,
      "weight": 1,
      "rpm": 3,
      "max_concurrency": 1,
      "timeout_s": 180,
      "doc": "https://huggingface.co/docs/inference-providers/index",
      "quota_note": "Inference Providers 每月提供少量免费额度，规则经常调整",
      "risk_note": "冷启动可能返回 503；需同意模型许可；国内网络可能不稳"
    },
    {
      "name": "wanxiang_free",
      "kind": "image",
      "base_url": "https://dashscope.aliyuncs.com",
      "path": "/api/v1/services/aigc/text2image/image-synthesis",
      "style": "dashscope_image",
      "model": "wanx2.1-t2i-turbo",
      "api_key": "",
      "enabled": true,
      "weight": 1,
      "rpm": 2,
      "max_concurrency": 1,
      "timeout_s": 180,
      "doc": "https://help.aliyun.com/zh/model-studio/text-to-image",
      "quota_note": "部分万相模型有免费额度/有效期限制",
      "risk_note": "异步任务接口，需 X-DashScope-Async 头；超出免费额度会计费"
    },
    {
      "name": "wanxiang_video",
      "kind": "video",
      "base_url": "https://dashscope.aliyuncs.com",
      "path": "/api/v1/services/aigc/video-generation/video-synthesis",
      "style": "dashscope_video",
      "model": "wanx2.1-t2v-turbo",
      "api_key": "",
      "enabled": true,
      "weight": 1,
      "rpm": 2,
      "max_concurrency": 1,
      "timeout_s": 900,
      "doc": "https://help.aliyun.com/zh/model-studio/text-to-video",
      "quota_note": "万相视频模型对新用户有免费额度，以百炼控制台为准",
      "risk_note": "异步任务接口，需 X-DashScope-Async 头；与 wanxiang_free 共用同一个 DashScope Key；超出免费额度会计费"
    },
    {
      "name": "minimax_video",
      "kind": "video",
      "base_url": "https://api.minimax.chat",
      "path": "/v1/video_generation",
      "style": "minimax_video",
      "model": "T2V-01",
      "api_key": "",
      "enabled": false,
      "weight": 1,
      "rpm": 2,
      "max_concurrency": 1,
      "timeout_s": 600,
      "doc": "https://platform.minimaxi.com/document/Video%20Generation",
      "quota_note": "视频生成通常无长期免费额度，仅活动赠送",
      "risk_note": "费用较高、任务耗时长；务必确认余额，建议默认关闭"
    },
    {
      "name": "free_video_trial",
      "kind": "video",
      "base_url": "",
      "path": "",
      "style": "generic_video",
      "model": "",
      "api_key": "",
      "enabled": false,
      "weight": 1,
      "rpm": 2,
      "max_concurrency": 1,
      "timeout_s": 600,
      "doc": "https://huggingface.co/docs/inference-providers/index",
      "quota_note": "占位源：需自行寻找当期提供免费试用的视频生成服务并填写地址",
      "risk_note": "示例占位，未配置 base_url 时永不调用；切勿填写来路不明的服务"
    }
  ],
  "pipeline": {
    "disabled": [],
    "order": []
  },
  "planner": {
    "history_token_budget": 600,
    "conversation_token_budget": 400
  },
  "agent_loop": {
    "enabled": true,
    "goal": "持续产出高质量短视频内容，并根据复盘持续优化",
    "max_rounds_per_day": 6,
    "dry_run": false
  },
  "memory": {
    "enabled": true
  }
}
